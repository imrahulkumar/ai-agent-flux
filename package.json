{
  "name": "ai-agent-flux",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file=.env server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
